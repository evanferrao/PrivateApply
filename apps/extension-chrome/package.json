{
  "name": "private-apply-chrome-extension",
  "version": "0.9.0",
  "description": "AI-powered Chrome extension for job application auto-fill, compatibility analysis, and cover letter generation",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build.mjs --browser=chrome",
    "dev": "node ../../scripts/build.mjs --browser=chrome --watch",
    "package": "node ../../scripts/package.mjs --browser=chrome",
    "type-check": "cd ../.. && npm run type-check",
    "lint": "cd ../.. && npm run lint",
    "test": "cd ../.. && npm test",
    "test:watch": "cd ../.. && npm run test:watch"
  },
  "keywords": [
    "chrome",
    "webextension",
    "job-application",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.137",
    "elkjs": "^0.12.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.6"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
