{
  "name": "private-apply",
  "version": "1.0.0",
  "description": "<div align=\"center\">   <img src=\"public/icons/logo-full-400w.png\" alt=\"Private Apply\" width=\"320\" />   <h3>Privacy-first job application assistant for Chrome & Firefox</h3>   <p>Auto-fill forms · AI cover letters · Local Ollama · Zero cloud · Zero tracking</p>",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "dev": "node scripts/build.mjs --watch",
    "dev:chrome": "node scripts/build.mjs --browser=chrome --watch",
    "dev:firefox": "node scripts/build.mjs --browser=firefox --watch",
    "package": "node scripts/package.mjs",
    "package:chrome": "node scripts/package.mjs --browser=chrome",
    "package:firefox": "node scripts/package.mjs --browser=firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelnishanth/private-apply.git"
  },
  "keywords": [
    "chrome",
    "firefox",
    "webextension",
    "job-application",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.137",
    "elkjs": "^0.12.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.6"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
